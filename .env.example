# Public, required: canonical site URL used by metadata and sitemap generation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public, required at runtime: Supabase project URL and publishable/anon key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-only, optional: used only by explicitly privileged server-side workflows.
# Never prefix this variable with NEXT_PUBLIC_ and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only, optional storage configuration. Supabase is the initial provider.
STORAGE_PROVIDER=supabase
SUPABASE_STORAGE_BUCKET=woodbay-media
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=
